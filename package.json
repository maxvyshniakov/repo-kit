{
  "name": "@maxvyshniakov/repo-kit",
  "version": "0.5.0",
  "type": "module",
  "description": "Shared verification, pre-push, release and publish tooling for Bun-based JavaScript and TypeScript libraries.",
  "keywords": ["bun", "verify", "pre-push", "release", "changelog", "github-actions", "monorepo"],
  "author": "Max Wish (https://maxvyshniakov.com)",
  "homepage": "https://github.com/maxvyshniakov/repo-kit#readme",
  "bugs": "https://github.com/maxvyshniakov/repo-kit/issues",
  "packageManager": "bun@1.4.4",
  "bin": {
    "repo-kit": "src/cli.mjs",
    "repo-kit-lane": "src/lanefather.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./changelog": "./src/changelog.mjs",
    "./packed-consumer": "./src/packed-consumer.mjs",
    "./publish": "./src/publish.mjs",
    "./release": "./src/release.mjs",
    "./shoot": "./src/shoot.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "hooks",
    "README.md",
    "docs/reference.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.4"
  },
  "peerDependencies": {
    "playwright": ">=1.50.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "scripts": {
    "prepare": "node src/cli.mjs hooks install",
    "verify": "node src/cli.mjs verify",
    "test": "node --test 'test/*.test.mjs'",
    "check": "node src/cli.mjs check",
    "check:changelogs": "node src/cli.mjs check-changelogs",
    "check:consumer": "node src/cli.mjs packed-consumer",
    "check:upstream": "node scripts/check-upstream.mjs",
    "release": "node src/cli.mjs release",
    "release:publish": "node src/cli.mjs publish",
    "repo-kit": "node src/cli.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxvyshniakov/repo-kit.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
